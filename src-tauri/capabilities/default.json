{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Markly PDF default capability for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:read-files",
    "fs:write-files",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select"
  ]
}
