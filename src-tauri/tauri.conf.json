{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markly PDF",
  "version": "0.1.0",
  "identifier": "com.markly.pdf",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Markly PDF",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Markly",
    "copyright": "Copyright © 2026 Markly. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Read. Highlight. Note. Organize.",
    "longDescription": "Markly PDF is a modern Windows PDF productivity application for reading, highlighting, notes, annotations and local organization.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "C07B7BD7-526E-44A3-ACE6-1807A7CFE791",
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
